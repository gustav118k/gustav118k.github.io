#!/usr/bin/env node
// Verschlüsselt alle <p>, <h4>, <ul> und <table> einer HTML-Datei, die noch kein data-encrypted (und kein data-plain) haben.
// <p>, <h4>, <ul>: Inhalt wird verschlüsselt, das Tag bleibt (<p data-encrypted>…</p>).
// <table>: die ganze Tabelle wird verschlüsselt und durch <div data-encrypted="outer">…</div> ersetzt
//          (Text direkt in einer <table> würde der Browser sonst aus der Tabelle herausschieben).
// <img>: src wird zu data-src, damit bis zur Entschlüsselung nur der alt-Text angezeigt wird.
// Nutzung: ./encrypt findmoose.html -p MyPassword123
//
// Format pro Element (Base64): salt(16) | iv(12) | Ciphertext | GCM-Tag(16)
// Schlüssel: PBKDF2-SHA256, 600000 Iterationen -> AES-256-GCM. Muss zum Script in findmoose.html passen.

const fs = require("fs");
const crypto = require("crypto");
const ITERATIONS = 600000;
const EL = /<(p|h4|ul|table)(\s[^>]*)?>([\s\S]*?)<\/\1>/g;
const ENC = /<(p|h4|ul|div)(\s[^>]*\bdata-encrypted\b[^>]*)>([\s\S]*?)<\/\1>/;
const IMG = /<img(\s[^>]*)?>/g;

const [file, flag, password] = process.argv.slice(2);
if (!file || flag !== "-p" || !password) {
    console.error("Nutzung: ./encrypt <datei.html> -p <passwort>");
    process.exit(1);
}

function decrypt(data, key) {
    const iv = data.subarray(16, 28);
    const body = data.subarray(28);
    const d = crypto.createDecipheriv("aes-256-gcm", key, iv);
    d.setAuthTag(body.subarray(body.length - 16));
    return Buffer.concat([d.update(body.subarray(0, body.length - 16)), d.final()]).toString("utf8");
}

let html = fs.readFileSync(file, "utf8");

// Salt der Seite wiederverwenden, falls schon Elemente verschlüsselt sind.
// Dabei wird geprüft, dass das Passwort dazu passt (sonst hätte die Seite zwei Passwörter).
let salt = null, key = null;
const existing = html.match(ENC);
if (existing) {
    const data = Buffer.from(existing[3].trim(), "base64");
    salt = data.subarray(0, 16);
    key = crypto.pbkdf2Sync(password, salt, ITERATIONS, 32, "sha256");
    try { decrypt(data, key); }
    catch { console.error("Fehler: Passwort passt nicht zu den bereits verschlüsselten Elementen."); process.exit(1); }
} else {
    salt = crypto.randomBytes(16);
    key = crypto.pbkdf2Sync(password, salt, ITERATIONS, 32, "sha256");
}

function encrypt(text) {
    const iv = crypto.randomBytes(12);
    const c = crypto.createCipheriv("aes-256-gcm", key, iv);
    const ct = Buffer.concat([c.update(text, "utf8"), c.final(), c.getAuthTag()]);
    return Buffer.concat([salt, iv, ct]).toString("base64");
}

let encrypted = 0, skipped = 0, images = 0;
html = html.replace(EL, (match, tag, attrs = "", content) => {
    if (/\bdata-(encrypted|plain)\b/.test(attrs)) { skipped++; return match; }
    encrypted++;
    if (tag === "table") return `<div data-encrypted="outer">${encrypt(match)}</div>`;
    return `<${tag}${attrs} data-encrypted>${encrypt(content)}</${tag}>`;
});

html = html.replace(IMG, (match, attrs = "") => {
    if (/\bdata-plain\b/.test(attrs) || !/\ssrc=/.test(attrs)) return match;
    images++;
    return `<img${attrs.replace(/\ssrc=/, " data-src=")}>`;
});

fs.writeFileSync(file, html, "utf8");
console.log(`Verschlüsselt: ${encrypted} Elemente, übersprungen: ${skipped}, Bilder ausgeblendet: ${images}`);
